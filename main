use async_trait::async_trait;
use serde_json::json;
use std::env;
use std::io::{self, Write};
use std::sync::Mutex;

// 1. Definisikan struktur pesan untuk Gemini API
#[derive(Debug, Clone)]
struct ChatMessage {
    role: String,
    text: String,
}

// 2. Trait (Interface OOP) Agen
#[async_trait]
pub trait Agent {
    fn get_name(&self) -> &str;
    async fn chat(&self, prompt: &str) -> Result<String, Box<dyn std::error::Error>>;
    fn clear_memory(&self);
}

// 3. Struct Agen dengan Encapsulated Memory
pub struct GeminiAgent {
    name: String,
    api_key: String,
    model: String,
    client: reqwest::Client,
    memory: Mutex<Vec<ChatMessage>>,
}

impl GeminiAgent {
    pub fn new(name: &str, model: &str) -> Result<Self, String> {
        let api_key = env::var("GEMINI_API_KEY")
            .map_err(|_| "Error: GEMINI_API_KEY tidak ditemukan di .env".to_string())?;

        Ok(Self {
            name: name.to_string(),
            api_key,
            model: model.to_string(),
            client: reqwest::Client::new(),
            memory: Mutex::new(Vec::new()),
        })
    }
}

// 4. Implementasi Trait Agent untuk GeminiAgent
#[async_trait]
impl Agent for GeminiAgent {
    fn get_name(&self) -> &str {
        &self.name
    }

    async fn chat(&self, prompt: &str) -> Result<String, Box<dyn std::error::Error>> {
        // a. Susun riwayat percakapan yang ada + pesan baru dari User
        let contents_json: Vec<serde_json::Value> = {
            let mut mem = self.memory.lock().unwrap();
            mem.push(ChatMessage {
                role: "user".to_string(),
                text: prompt.to_string(),
            });

            mem.iter()
                .map(|msg| {
                    json!({
                        "role": msg.role,
                        "parts": [{ "text": msg.text }]
                    })
                })
                .collect()
        };

        // b. URL Endpoint Gemini API yang sudah diperbaiki
        let url = format!(
            "https://generativelanguage.googleapis.com/v1beta/models/{}:generateContent?key={}",
            self.model, self.api_key
        );

        let body = json!({
            "contents": contents_json
        });

        // c. Kirim request ke Gemini API
        let response = match self.client.post(&url).json(&body).send().await {
            Ok(res) => res,
            Err(err) => {
                // Rollback memori user jika request gagal terkirim
                self.memory.lock().unwrap().pop();
                return Err(err.into());
            }
        };

        let res_json: serde_json::Value = response.json().await?;

        // d. Ekstraksi jawaban dari Model
        if let Some(reply) = res_json["candidates"][0]["content"]["parts"][0]["text"].as_str() {
            let model_reply = reply.trim().to_string();

            // e. Simpan jawaban Model ke dalam memori agen untuk turn berikutnya
            {
                let mut mem = self.memory.lock().unwrap();
                mem.push(ChatMessage {
                    role: "model".to_string(),
                    text: model_reply.clone(),
                });
            }

            Ok(model_reply)
        } else {
            // Rollback pesan user terakhir jika API mengembalikan error (misal: kuota habis / model salah)
            self.memory.lock().unwrap().pop();
            Err(format!("Gagal mengambil respons. Detail API: {}", res_json).into())
        }
    }

    fn clear_memory(&self) {
        let mut mem = self.memory.lock().unwrap();
        mem.clear();
        println!("🧠 Memori {} telah dibersihkan.", self.name);
    }
}

// 5. Fungsi Utama (CLI Interaktif)
#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Load file .env
    dotenvy::dotenv().ok();

    // Inisialisasi agen (Ganti nama model sesuai kebutuhan, misal "gemini-2.5-flash")
    let agent = GeminiAgent::new("Gemini-Flash-Terminal", "gemini-3.5-flash-lite")
    .expect("Gagal menginisialisasi Agen");

    println!("==================================================");
    println!("🤖 Selamat datang! Anda terhubung dengan {}", agent.get_name());
    println!("Ketik 'keluar' untuk menyudahi percakapan.");
    println!("Ketik 'reset' untuk menghapus memori agen.");
    println!("==================================================\n");

    loop {
        print!("👤 Anda: ");
        io::stdout().flush()?;

        let mut input = String::new();
        io::stdin().read_line(&mut input)?;
        let input = input.trim();

        if input.eq_ignore_ascii_case("keluar") {
            println!("👋 Sampai jumpa!");
            break;
        }

        if input.eq_ignore_ascii_case("reset") {
            agent.clear_memory();
            continue;
        }

        if input.is_empty() {
            continue;
        }

        println!("🤖 {} sedang berpikir...", agent.get_name());

        match agent.chat(input).await {
            Ok(reply) => {
                println!("\n🤖 {}:\n{}\n", agent.get_name(), reply);
                println!("--------------------------------------------------");
            }
            Err(err) => {
                eprintln!("\n❌ Terjadi error: {}\n", err);
            }
        }
    }

    Ok(())
}
